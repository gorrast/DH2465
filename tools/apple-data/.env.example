# Local collector only. Default exports do NOT read this file or use the network.
# Fill this for an explicitly requested --preview / --upload / --check-connection.
# See README.md: deploy the separate endpoint before online use.
# Supabase Connect / Settings > API Keys. Same PUBLIC values as your app.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Email of a user who signs into YOUR APP (not your Supabase dashboard account).
# Leave the password blank to enter it privately in the terminal each run.
SUPABASE_EMAIL=
SUPABASE_PASSWORD=

# Alternative for OAuth-only users: a user access token from an existing app
# session. These are PRIVATE values: never prefix them with NEXT_PUBLIC_.
# A refresh token lets the upload continue when the access token expires.
SUPABASE_ACCESS_TOKEN=
SUPABASE_REFRESH_TOKEN=

# The StressLess API (the deployed Vercel URL, or http://localhost:8000 locally).
# Used only by --derive, after you upload the raw data.
STRESSLESS_API_URL=

# Optional: make preview/upload refuse a different verified account.
SUPABASE_USER_ID=

# No database URI, database password, or service/secret key belongs in this file.
# Old SUPABASE_DB_URL values are ignored; the old SQL/RPC uploader is disabled.
