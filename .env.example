# Copy to .env.local (Next.js and the local FastAPI both read it) and fill in from
# Supabase → Project Settings → API. On Vercel, set the same variables in Project → Settings → Environment Variables.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Only for projects still on the legacy JWT secret (Settings → JWT Keys → Legacy JWT secret).
# Leave unset for projects using asymmetric signing keys (the default): the API verifies tokens with the JWKS.
# SUPABASE_JWT_SECRET=

# Optional: personal Steam Sync now. All three are server-only (no NEXT_PUBLIC_ prefix).
# SteamID64: your 17-digit Steam account ID. Bind it to your Supabase Auth user UUID.
# STEAM_WEB_API_KEY=
# STEAM_ID=
# STEAM_SYNC_USER_ID=

# Optional: Last.fm listening sync. One app-wide API key (https://www.last.fm/api/account/create); no shared secret
# or callback is needed. Each user connects their own Last.fm username on the Media page.
# LASTFM_API_KEY=

# Optional: automatic Netflix posters on import. Use TMDB's API Read Access Token (Bearer token).
# TMDB_READ_ACCESS_TOKEN=
# TMDB_LANGUAGE=sv-SE

# Data the API shows: demo (simulated personas, the default) or real (each user's own synced data).
# STRESSLESS_DATA=demo

# Optional: freeze "today" for every user, e.g. for a stable presentation (YYYY-MM-DD).
# STRESSLESS_ANCHOR=2026-09-27

# Optional: let Claude write the morning narrative (falls back to on-device rules on any error).
# STRESSLESS_REASONER=claude
# ANTHROPIC_API_KEY=
# Generated reports: model per kind, effort, and the cap on model calls per 24 h across all users.
# STRESSLESS_DAILY_MODEL=claude-sonnet-5-5
# STRESSLESS_WEEKLY_MODEL=claude-sonnet-5-5
# STRESSLESS_REPORT_EFFORT=medium
# STRESSLESS_REPORT_DAILY_CAP=50

# Optional: Google Calendar connection (the Calendar view). Without these the API answers 503 on /api/calendar/google/*.
# In Google Cloud Console, register <APP_URL>/api/calendar/google/callback as an authorized redirect URI.
# APP_URL=http://localhost:3000
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# 32 random bytes, base64: openssl rand -base64 32. Encrypts the stored Google refresh tokens.
# GOOGLE_TOKEN_ENCRYPTION_KEY=
# Server only, never NEXT_PUBLIC_: the connection tables are not writable by signed-in users.
# SUPABASE_SERVICE_ROLE_KEY=
